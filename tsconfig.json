{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "@testing-library/jest-dom"]
  },
  "//": "Type-check/emit only the public API graph reachable from the entry point. Unexported components still being migrated (e.g. Combobox) and the examples are intentionally out of this graph.",
  "files": ["src/index.ts"]
}
