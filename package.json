{
  "name": "monoui",
  "version": "0.1.6",
  "description": "monochromatic-ish UI library",
  "license": "MIT",
  "author": "Juan Olvera",
  "keywords": [
    "React",
    "UI",
    "Components"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@git.uwu.ms:2221/jolvera/monoui.git"
  },
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.17.1"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun scripts/build.ts",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "dev": "storybook dev -p 6006",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,mdx}\""
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-primitive": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "accounting": "^0.4.1",
    "class-variance-authority": "^0.4.0",
    "clsx": "^1.2.1",
    "cmdk": "^0.2.0",
    "dashify": "^2.0.0",
    "lodash-es": "^4.17.21",
    "react-aria-components": "^1.4.0",
    "react-icons": "^4.12.0",
    "react-number-format": "^5.1.4",
    "tailwind-merge": "^1.11.0",
    "ts-pattern": "^5.0.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/accounting": "^0.4.5",
    "@types/bun": "^1.1.0",
    "@types/dashify": "^1.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.13",
    "postcss": "^8.4.33",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.6.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  }
}
